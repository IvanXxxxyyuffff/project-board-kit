#pragma code_page(65001)
/* 项目看板 资源：托盘/任务栏图标 + 版本信息（任务管理器显示「项目看板」） */

1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Project Board"
            VALUE "FileDescription", "项目看板"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "project-board"
            VALUE "OriginalFilename", "项目看板.exe"
            VALUE "ProductName", "项目看板"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
